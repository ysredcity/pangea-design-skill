# 默认构建配置（所有 mode 都会先加载本文件，再被 .env.<mode> 覆盖）
#
# 默认：Hash 路由 + 相对 base —— 产物可直接丢到任意静态托管的任意子路径，
# 无需服务端 SPA fallback，覆盖绝大多数交付场景。
# 其他部署场景见 references/overview/deployment.md：
#   - npm run build:embed    嵌入式单文件（飞书 aily / 妙搭 / Coze / iframe）
#   - npm run build:history  History 路由（需服务端 SPA fallback，URL 无 #）

# 路由模式：hash | history
VITE_ROUTER_MODE=hash

# 资源基础路径：'./' 相对（任意子路径可用）| '/' 绝对（部署在域名根）
VITE_BASE=./

# 构建目标：standard 正常分包 | embed 全部内联为单个 HTML
VITE_BUILD_TARGET=standard
